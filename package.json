{
  "name": "petunia",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.21",
    "expo-av": "^16.0.8",
    "expo-constants": "^57.0.17",
    "expo-gl": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "^57.0.9",
    "expo-router": "^57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node -e \"const s=require('sharp');const p=require('path');(async()=>{await s('assets/icon.png').resize(192,192).png().toFile('public/logo192.png');await s('assets/icon.png').resize(512,512).png().toFile('public/logo512.png');console.log('Icons generated')})()\"",
    "build:web": "npm run generate-icons && expo export --platform web",
    "start:web": "npx serve dist"
  },
  "private": true
}
